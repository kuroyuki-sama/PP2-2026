      "안녕 !\n",
      "안녕!\n"
     ]
    }
   ],
   "source": [
    "def greet(msg: str):\n",
    "    print(msg, \"!\")\n",
    "    return msg + \"!\"\n",
    "\n",
    "print(greet(\"안녕\"))"
   ]
